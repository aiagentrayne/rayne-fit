{
  "name": "rayne-fit",
  "version": "1.0.0",
  "private": true,
  "description": "Personal accountability scorecard PWA: binary YES/NO daily scoring, letter grades, reminders and nudges.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "node scripts/migrate.mjs",
    "vapid": "web-push generate-vapid-keys --json",
    "icons": "python3 scripts/make_icons.py"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "idb-keyval": "6.3.0",
    "luxon": "3.7.2",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "web-push": "3.6.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/luxon": "3.7.1",
    "@types/node": "22.18.8",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/web-push": "3.6.4",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
