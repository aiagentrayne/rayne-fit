# --- Supabase (Project settings > API / Database) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side Postgres connection. Use the "Transaction pooler" URI (port 6543) on Vercel.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Web Push (generate with: npm run vapid) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Secrets (generate each with: openssl rand -base64 32) ---
# Signs notification action buttons (Mark YES / NO / Snooze).
ACTION_TOKEN_SECRET=
# Authorizes the scheduler endpoint /api/cron/tick.
CRON_SECRET=

# --- Local development only. Never set in production. ---
# DEV_AUTH=1   # local test user; ignored when NEXT_PUBLIC_SUPABASE_URL is set or on Vercel
